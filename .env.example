# =============================================================================
# BRANDGUARD AI - ENVIRONMENT CONFIGURATION (.env.example)
# DO NOT COMMIT SENSITIVE SECRETS OR REAL KEYS TO VERSION CONTROL.
# =============================================================================

# Server-Side Gemini API Key (called strictly by backend Express / Edge Functions)
# Frontend client NEVER accesses this key.
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Public Configuration (accessible in frontend for Auth & RLS client queries)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key-here"

# Supabase Server-Side Service Role Key (NEVER expose to frontend; used by backend only)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Application Server Port
PORT=3000
